<Project Sdk="Godot.NET.Sdk/4.4.0">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>

		<Description>Includes types and data objects for Godot that other Petra libraries are likely to use</Description>
		<PackageTags>OpenSourceKingdom, OpenSource, Petra, Game, Framework, Suite, Tool, Primitive, Data, Object, Identifier</PackageTags>
		<Title>OSK.Petra.Godot.Primitives</Title>
		<Authors>BlankDev117</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/OpenSourceKingdom/OSK.Petra.Godot.Primitives</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	
	<!-- Required Build and Nuget setup for Godot injection -->

	<ItemGroup>
		<Content Include="Data\**\*.cs">
			<Pack>true</Pack>
			<PackagePath>godot\Data\%(RecursiveDir)</PackagePath>
		</Content>
		<Content Include="Scripts\**\*.cs">
			<Pack>true</Pack>
			<PackagePath>godot\Scripts\%(RecursiveDir)</PackagePath>
		</Content>
	</ItemGroup>

	<!-- Removing this from compilation to prevent duplicate type related (CS0436) errors from the injected code and the compiled code being in the same package -->
	<ItemGroup>
		<Compile Remove="Data\**\*.cs" />
		<Compile Remove="Scripts\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\OSK.Petra.Godot.targets" Pack="true" PackagePath="buildTransitive\$(MSBuildProjectName).targets" />
	</ItemGroup>
</Project>
